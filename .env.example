# Environment configuration template
# Copy this file to .env and fill in your actual values

# Optional: Internal proxy settings (remove if not needed)
# INTERNAL_PROXY_HOST: http_proxy_host_here
# INTERNAL_DOMAIN: internal_domain_here
# INTERNAL_CERT_NAME: cert_file.crt
# INTERNAL_PYPI_MIRROR: http://proxy:port/mirror
# PYTHON_MIRROR_URL: https://mirror-url/python.tar.gz
