{
  "name": "Term Lookup",
  "version": "1.0",
  "category": "lookup",
  "description": "Search SNOMED CT descriptions by term with exact and fuzzy matching",
  "classes": [
    {
      "name": "SnomedTermLookup",
      "methods": [
        {
          "name": "__init__",
          "description": "Initialize lookup with SNOMED description file path",
          "parameters": [
            {"name": "snomed_description_path", "type": "str", "required": false, "default": null},
            {"name": "active_only", "type": "bool", "required": false, "default": true}
          ]
        },
        {
          "name": "find_concepts_by_term",
          "description": "Find concepts by matching term with substring or prefix search",
          "parameters": [
            {"name": "term", "type": "str", "required": true},
            {"name": "ignore_case", "type": "bool", "required": false, "default": true},
            {"name": "match_prefix", "type": "bool", "required": false, "default": false},
            {"name": "top_n", "type": "int", "required": false, "default": null}
          ],
          "returns": [
            {
              "type": "list",
              "item_type": "tuple",
              "description": "List of (cui, term) tuples for matching concepts"
            }
          ]
        },
        {
          "name": "find_concepts_by_term_fuzzy",
          "description": "Find concepts using fuzzy string matching with scoring",
          "parameters": [
            {"name": "term", "type": "str", "required": true},
            {"name": "min_score", "type": "int", "require": false, "default": 50},
            {"name": "top_n", "type": "int", "required": false, "default": null}
          ],
          "returns": [
            {
              "type": "list",
              "item_type": "tuple",
              "description": "List of (cui, term, score) tuples"
            }
          ]
        },
        {
          "name": "find_concepts_batch",
          "description": "Search for multiple terms at once",
          "parameters": [
            {"name": "terms", "type": "list[str]", "required": true},
            {"name": "ignore_case", "type": "bool", "required": false, "default": true},
            {"name": "match_prefix", "type": "bool", "required": false, "default": false}
          ],
          "returns": [
            {
              "type": "list",
              "item_type": "tuple",
              "description": "List of (term, cui, matched_term) tuples"
            }
          ]
        },
        {
          "name": "getconcept_info",
          "description": "Get detailed information about a specific concept",
          "parameters": [
            {"name": "cui", "type": "str", "required": true}
          ],
          "returns": [
            {
              "type": "dict",
              "description": "Concept details including cui, preferred_name, type_id"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "name": "create_term_lookup_from_directory",
      "description": "Convenience function to create lookup from SNOMED directory",
      "parameters": [
        {"name": "sct2_dir", "type": "str", "required": true},
        {"name": "active_only", "type": "bool", "required": false, "default": true}
      ],
      "returns": {
        "type": "SnomedTermLookup"
      }
    }
  ],
  "example_usage": [
    "from snomed_term_lookup import create_term_lookup_from_directory",
    "lookup = create_term_lookup_from_directory('/path/to/snomed')",
    "# Substring search (case-insensitive)",
    "results = lookup.find_concepts_by_term('meningioma')",
    "# Prefix matching",
    "prefix_results = lookup.find_concepts_by_term('mening', match_prefix=True)",
    "# Fuzzy matching",
    "fuzzy_results = lookup.find_concepts_by_term_fuzzy('meningoma', min_score=80)",
    "# Batch search",
    "batch = lookup.find_concepts_batch(['brain tumor', 'liver cancer'])"
  ]
}
